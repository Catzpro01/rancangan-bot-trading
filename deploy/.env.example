# deploy/.env.example — salin menjadi deploy/.env lalu isi.
# JANGAN pernah commit berkas .env. Isinya hanya nama variabel + contoh, tanpa rahasia.
#
# tools/validate_mirofish_contract.py memeriksa bahwa setiap $env yang dipakai
# workflow n8n terdaftar di sini. Menambah $env baru tanpa menambahkannya ke berkas
# ini akan menggagalkan CI.

# ---------------------------------------------------------------- n8n
N8N_HOST=n8n.internal.example.com
N8N_ENCRYPTION_KEY=ganti-dengan-output-openssl-rand-hex-24
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=ganti-ini-panjang-dan-acak
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# ---------------------------------------------------------------- Postgres
POSTGRES_USER=bot
POSTGRES_PASSWORD=ganti-ini-panjang-dan-acak
POSTGRES_DB=bot_trading
DATABASE_URL=postgres://bot:ganti-ini@postgres:5432/bot_trading

# ---------------------------------------------------------------- Pionex
# Kunci API WAJIB hanya permission "reading" + "trading".
# JANGAN pernah mengaktifkan "transfer" / "Enable transfer" pada kunci ini:
# kalau kunci bocor, kerugian maksimal adalah posisi yang buruk, bukan saldo yang
# ditarik keluar. Lihat docs/05 §3 dan docs/07 §4.
PIONEX_API_KEY=
PIONEX_API_SECRET=
PIONEX_SYMBOL=BTC_USDT_PERP
PIONEX_BASE_URL=https://api.pionex.com

# ---------------------------------------------------------------- Cache (Redis)
# cache.kv untuk workflow 07/08/09. Redis TIDAK dipublikasikan ke host.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ganti-ini-panjang-dan-acak

# ---------------------------------------------------------------- LLM untuk simulasi agen (workflow 08)
# Endpoint apa pun yang kompatibel dengan OpenAI /chat/completions:
#   OpenAI    https://api.openai.com/v1
#   Groq      https://api.groq.com/openai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Ollama    http://ollama:11434/v1   (lokal, tanpa biaya API)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Batas keras biaya. Satu sweep = 6 panggilan (5 agen + 1 sintesis).
LLM_MAX_CALLS_PER_DAY=200

# ---------------------------------------------------------------- MiroFish runner (OPSIONAL)
# Hanya dibutuhkan bila Anda memakai workflow 06 (MiroFish asli lewat CLI).
# Bila Anda memakai workflow 07+08 (simulasi agen di dalam n8n), bagian ini
# boleh dikosongkan dan layanan mirofish-runner boleh dimatikan.
MIROFISH_RUNNER_URL=http://mirofish-runner:8100
MIROFISH_RUNNER_TOKEN=ganti-ini-panjang-dan-acak
MIROFISH_RUNNER_DATA=data/mirofish
MIROFISH_ARTIFACTS=data/mirofish/runs
MIROFISH_BIN=mirofish
MIROFISH_MAX_ROUNDS=10
MIROFISH_PLATFORM=parallel
MIROFISH_TIMEOUT_SEC=3600
# MIROFISH_FAKE=1 membuat runner menghasilkan artefak palsu berbentuk benar.
# Hanya untuk uji integrasi di lingkungan tanpa kredensial LLM.
MIROFISH_FAKE=0
MIROFISH_CWD=

# ---------------------------------------------------------------- Notifikasi
ALERT_EMAIL=ops@example.com
